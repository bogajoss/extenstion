{
  "manifest_version": 3,
  "name": "Facebook Comment Finder",
  "version": "2.0",
  "description": "Find Facebook posts with high comments and low shares",
  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["https://*.facebook.com/*"]
    }
  ]
}
