{
  "manifest_version": 3,
  "name": "Prohor Facebook Toolkit",
  "version": "2.0",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "description": "Find Facebook posts with high comments and low shares",
  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "action": { "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "fonts/*"],
      "matches": ["https://*.facebook.com/*"]
    }
  ]
}
